# Supabase project credentials
# Find these at: Supabase Dashboard > Project Settings > API
# Copy this file to `.env.local` and fill in the real values.

# Project URL — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key — safe to expose to the browser, protected by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
